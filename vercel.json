{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "^niraj-new(?:-kappa)?\\.vercel\\.app$" }
      ],
      "headers": { "Location": "https://www.nirajtrivedi-cs.com/$1" },
      "status": 308
    },
    {
      "src": "/index\\.html",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "/((?:about|people|contact|services(?:/[^/]+)?|privacy|terms|cookies|admin|error))(?:/index\\.html|/)",
      "headers": { "Location": "/$1" },
      "status": 308
    },
    {
      "src": "/admin",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
